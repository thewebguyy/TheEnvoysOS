generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  media    Media[]
  services Service[]
  songs    Song[]
}

enum Role {
  ADMIN
  TECH_DIRECTOR
  OPERATOR
  VOLUNTEER
  VIEWER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(VIEWER)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

model Media {
  id           String   @id @default(uuid())
  name         String
  key          String   // S3 object key
  url          String?
  type         String
  size         Int
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedById String?
  createdAt    DateTime @default(now())

  segments     Segment[]
  sermons      Sermon[]
  clips        Clip[]

  @@index([tenantId])
}

model Service {
  id          String    @id @default(uuid())
  name        String
  date        DateTime
  status      String    @default("DRAFT") // DRAFT, LIVE, COMPLETED
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  segments    Segment[]
  sermons     Sermon[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
}

enum SegmentType {
  WORSHIP_SET
  ANNOUNCEMENTS
  SERMON
  OFFERING
  CLOSING
  CUSTOM
}

model Segment {
  id         String      @id @default(uuid())
  serviceId  String
  service    Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  type       SegmentType
  title      String
  order      Int
  duration   Int?        // Expected duration in seconds
  notes      String?
  speaking   String?     // Speaker name for sermon segments
  mediaId    String?
  media      Media?      @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([serviceId])
}

model Sermon {
  id           String          @id @default(uuid())
  title        String
  speaker      String
  date         DateTime        @default(now())
  serviceId    String?
  service      Service?        @relation(fields: [serviceId], references: [id])
  thumbnailUrl String?
  mediaId      String?
  media        Media?          @relation(fields: [mediaId], references: [id])
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  segments     SermonSegment[]
  clips        Clip[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([tenantId])
}

model SermonSegment {
  id        String   @id @default(uuid())
  sermonId  String
  sermon    Sermon   @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  title     String
  startTime Int?     // Start time in seconds
  endTime   Int?     // End time in seconds
  type      String?  // e.g. "Clips", "Moment", "Key Point"
  clips     Clip[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sermonId])
}

model Clip {
  id          String         @id @default(uuid())
  sermonId    String
  sermon      Sermon         @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  segmentId   String
  segment     SermonSegment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  title       String
  caption     String?
  platform    String?        // "YOUTUBE", "INSTAGRAM", "FACEBOOK", "TIKTOK"
  status      String         @default("DRAFT") // "DRAFT", "READY", "PROCESSING", "EXPORTED", "FAILED"
  thumbnailId String?
  thumbnail   Media?         @relation(fields: [thumbnailId], references: [id])
  
  exportUrl   String?
  error       String?
  exportedAt  DateTime?
  
  syncJobs    SyncJob[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([segmentId])
}

model SyncJob {
  id        String   @id @default(uuid())
  clipId    String
  clip      Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // "PENDING", "PROCESSING", "DONE", "FAILED"
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clipId])
}


model Song {
  id           String            @id @default(uuid())
  title        String
  author       String?
  ccliNumber   String?
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  arrangements SongArrangement[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([tenantId])
}

model SongArrangement {
  id        String        @id @default(uuid())
  songId    String
  song      Song          @relation(fields: [songId], references: [id], onDelete: Cascade)
  name      String        // e.g. "Default", "Acoustic"
  sections  SongSection[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([songId])
}

model SongSection {
  id            String          @id @default(uuid())
  arrangementId String
  arrangement   SongArrangement @relation(fields: [arrangementId], references: [id], onDelete: Cascade)
  name          String          // e.g. "Verse 1", "Chorus"
  order         Int
  slides        LyricSlide[]

  @@index([arrangementId])
}

model LyricSlide {
  id           String      @id @default(uuid())
  sectionId    String
  section      SongSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text         String
  order        Int
  advanceDelay Int?        // For auto-advance mode (milliseconds)

  @@index([sectionId])
}

model SystemState {
  id    Int    @id @default(1)
  data  String // Store as string for easy migration from sqlite, but could be Json later
}

model SystemMeta {
  key   String @id
  value String
}
