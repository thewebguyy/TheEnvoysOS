{
  "name": "envoys-os-monorepo",
  "private": true,
  "version": "2.1.0",
  "description": "Modular, multi-product architecture for Envoys AI and PulpitOS",
  "workspaces": [
    "apps/*",
    "core/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@envoys/app\" \"npm run dev --workspace=@envoys/server\"",
    "build": "npm run build --workspaces",
    "clean": "rm -rf node_modules apps/*/node_modules core/*/node_modules packages/*/node_modules",
    "envoys:dev": "npm run dev --workspace=@envoys/app",
    "pulpitos:dev": "npm run dev --workspace=@envoys/pulpitos",
    "server:dev": "npm run dev --workspace=@envoys/server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}